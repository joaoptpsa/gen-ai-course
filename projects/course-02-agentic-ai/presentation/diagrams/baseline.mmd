---
config:
  layout: dagre
  look: classic
  theme: base
  themeVariables:
    fontSize: "20px"
    lineColor: "#333333"
    edgeLabelBackground: "#e8e8e8"
    primaryTextColor: "#222222"
  flowchart:
    wrappingWidth: 240
    nodeSpacing: 34
    rankSpacing: 72
---
flowchart LR
  incident(["Incidente"])
  agent["Agente único<br/>instruções e ferramentas"]
  memory[("Memória")]
  revision["Rever instruções"]

  incident --> agent -->|"registar lições"| memory
  memory --> revision --> agent

  classDef step fill:#1168bd,stroke:#5b9bd5,color:#ffffff
  classDef store fill:#4a4a4a,stroke:#9a9a9a,color:#ffffff
  class agent,revision step
  class memory store
