---
config:
  layout: elk
  look: classic
  theme: base
  themeVariables:
    fontSize: "20px"
    lineColor: "#333333"
    edgeLabelBackground: "#e8e8e8"
    primaryTextColor: "#222222"
  flowchart:
    wrappingWidth: 240
    nodeSpacing: 34
    rankSpacing: 72
---
flowchart LR
  input(["Alerta, ticket,<br/>reclamação"])
  orchestrator["Orquestrador"]
  network["Rede<br/>(só leitura)"]
  database["Base de dados<br/>(só leitura)"]
  remediation["Remediação<br/>(única que atua)"]
  reviewer["Revisor<br/>(só leitura)"]
  approval{{"Aprovação<br/>por papel<br/>(se crítica)"}}
  simulator[("Simulador<br/>Meridian")]

  input --> orchestrator
  orchestrator --> network
  network -->|"diagnóstico"| orchestrator
  orchestrator --> database
  database -->|"diagnóstico"| orchestrator
  orchestrator -->|"tarefa<br/>(+1 se falhar)"| remediation
  remediation -->|"relatório"| orchestrator
  remediation --> approval
  approval -->|"aprovado"| simulator
  orchestrator -->|"verificar"| reviewer
  simulator -->|"estado real"| reviewer
  reviewer -->|"veredito"| orchestrator

  classDef inputNode fill:#ffffff,stroke:#333333,color:#222222
  classDef agent fill:#1168bd,stroke:#5b9bd5,color:#ffffff
  classDef gate fill:#b85c00,stroke:#e0a060,color:#ffffff
  classDef store fill:#4a4a4a,stroke:#9a9a9a,color:#ffffff
  class input inputNode
  class orchestrator,network,database,remediation,reviewer agent
  class approval gate
  class simulator store
