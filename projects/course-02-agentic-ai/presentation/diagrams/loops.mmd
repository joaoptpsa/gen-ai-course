---
config:
  layout: dagre
  look: classic
  theme: base
  themeVariables:
    fontSize: "20px"
    lineColor: "#333333"
    edgeLabelBackground: "#e8e8e8"
    primaryTextColor: "#222222"
  flowchart:
    wrappingWidth: 260
    nodeSpacing: 52
    rankSpacing: 84
---
flowchart LR
  runs[("Execuções<br/>e traces OTel")]
  critic["Crítico<br/>aponta agente ou handoff"]
  versions["Versões<br/>altera um agente"]
  lessons["Lições<br/>memória por papel"]
  cases["Novos casos<br/>a partir de falhas"]
  gate{{"Treino melhora?<br/>Sem regressão<br/>na validação?"}}

  runs --> critic
  critic --> versions
  versions --> gate
  gate -->|"sim: nova versão"| runs
  runs -->|"após incidente"| lessons
  lessons -->|"antes de atuar"| runs
  critic --> cases
  cases -->|"revisão humana,<br/>só no treino"| runs

  classDef agent fill:#1168bd,stroke:#5b9bd5,color:#ffffff
  classDef gate fill:#b85c00,stroke:#e0a060,color:#ffffff
  classDef store fill:#4a4a4a,stroke:#9a9a9a,color:#ffffff
  class critic,versions,lessons,cases agent
  class gate gate
  class runs store
