---
flowchart LR
  execution["Orquestrador e equipa"]
  evidence["Resultados e traces"]
  memory["Memória"]
  versions["Versões"]
  cases["Casos de treino"]
  future["Execuções futuras"]

  execution --> evidence
  evidence --> memory & versions & cases
  memory & versions & cases --> future
  future --> execution

  classDef neutral fill:#334155,stroke:#334155,color:#ffffff
  class execution,evidence,future neutral
  classDef memory fill:#0f766e,stroke:#0f766e,color:#ffffff
  class memory memory
  classDef version fill:#1d4ed8,stroke:#1d4ed8,color:#ffffff
  class versions version
  classDef training fill:#92400e,stroke:#92400e,color:#ffffff
  class cases training
