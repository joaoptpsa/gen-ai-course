#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
# shellcheck source=bin/lib/_python-files.sh
source "$SCRIPT_DIR/lib/_python-files.sh"

usage() {
  echo 'usage: bin/format [path...]' >&2
  echo '  path  format only these files; without one, every tracked Python file' >&2
}

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
esac

# Paths given on the command line are relative to the caller's directory, so ruff runs from there.
if [[ $# -gt 0 ]]; then
  uv run --project "$SCRIPT_DIR/.." ruff format -- "$@"
  exit
fi

cd -- "$SCRIPT_DIR/.."
files=()
python_files_read files
uv run ruff format -- "${files[@]}"
